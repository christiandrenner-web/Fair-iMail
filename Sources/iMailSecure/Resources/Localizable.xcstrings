{
  "sourceLanguage": "de",
  "strings": {
    "%@\n\nDamit verlässt du iMail Secure. Die Zielseite kann deine IP-Adresse und den Zeitpunkt sehen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nYou are leaving iMail Secure. The destination site can see your IP address and the time you opened it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nVas a salir de iMail Secure. El sitio de destino puede ver tu dirección IP y la hora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nVous quittez iMail Secure. Le site de destination peut voir votre adresse IP et l'heure."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nВы покидаете iMail Secure. Сайт назначения может увидеть ваш IP-адрес и время."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\niMail Secure'den ayrılıyorsunuz. Hedef site IP adresinizi ve saati görebilir."
          }
        }
      }
    },
    "%@ hat eine Lesebestätigung angefordert.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ has requested a read receipt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha solicitado una confirmación de lectura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a demandé un accusé de lecture."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ запросил уведомление о прочтении."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ okundu bilgisi talep etti."
          }
        }
      }
    },
