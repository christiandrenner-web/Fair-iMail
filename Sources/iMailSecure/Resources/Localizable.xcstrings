        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro открывает удобство. Всё, что защищает ваши данные, остаётся в бесплатной версии."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
